# ============================================================================
# LLM — tương thích OpenAI API. Đổi 3 dòng dưới đây để chuyển nhà cung cấp mà
# KHÔNG cần sửa code. Xem README mục "Chọn nhà cung cấp LLM" để so sánh.
# ============================================================================

# --- Mặc định: Groq (nhanh, free tier hào phóng) ---
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# model tương ứng khai báo trong config.yaml: openai/gpt-oss-120b

# --- Lựa chọn khác (bỏ comment 2 dòng tương ứng, comment 2 dòng Groq ở trên) ---
# Cerebras (cực nhanh, free tier tốt, model mạnh nhất hiện có: llama-3.3-70b)
# OPENAI_API_KEY=csk_your_cerebras_api_key
# OPENAI_BASE_URL=https://api.cerebras.ai/v1

# Google Gemini (qua lớp tương thích OpenAI, free tier rất hào phóng)
# OPENAI_API_KEY=your_gemini_api_key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter (tổng hợp nhiều model free, tiện để thử nghiệm nhiều lựa chọn)
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ============================================================================
# MongoDB
# ============================================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_scientist

# ============================================================================
# Tìm tài liệu tham khảo (TUỲ CHỌN — không có vẫn chạy, chỉ bị giới hạn tốc độ chặt hơn)
# ============================================================================
# SEMANTIC_SCHOLAR_API_KEY=your_key
# OPENALEX_MAILTO=you@example.com
# CROSSREF_MAILTO=you@example.com

# Groq: 80% of 8000 TPM reserved as safety headroom
LLM_TPM_LIMIT=8000
LLM_MAX_OUTPUT_TOKENS=1600
LLM_RPM_LIMIT=20
LLM_SAFETY_RATIO=0.80
LLM_MAX_CONCURRENCY=1
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=90
LLM_CACHE_TTL_SECONDS=3600
